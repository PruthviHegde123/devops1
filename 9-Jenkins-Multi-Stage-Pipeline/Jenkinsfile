pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                dir('9-Jenkins-Multi-Stage-Pipeline') {
                    echo 'Preparing Python application...'
                    sh 'python3 --version'
                    sh 'python3 -m pip --version'
                    sh 'python3 -m venv .venv'
                    sh '.venv/bin/python -m pip install -r requirements.txt'
                }
            }
        }

        stage('Test') {
            steps {
                dir('9-Jenkins-Multi-Stage-Pipeline') {
                    echo 'Running unit tests...'
                    sh '.venv/bin/python test_app.py'
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('9-Jenkins-Multi-Stage-Pipeline') {
                    echo 'Deploying application...'
                    sh '''
                        mkdir -p "${WORKSPACE}/python-app-deploy"
                        cp app.py requirements.txt "${WORKSPACE}/python-app-deploy/"
                    '''
                }
            }
        }

        stage('Run Application') {
            steps {
                dir('9-Jenkins-Multi-Stage-Pipeline') {
                    echo 'Starting application...'
                    sh '''
                        nohup "${WORKSPACE}/9-Jenkins-Multi-Stage-Pipeline/.venv/bin/python" app.py \
                            > "${WORKSPACE}/python-app-deploy/app.log" 2>&1 &
                        echo $! > "${WORKSPACE}/python-app-deploy/app.pid"
                        sleep 3
                    '''
                }
            }
        }

        stage('Test Application') {
            steps {
                dir('9-Jenkins-Multi-Stage-Pipeline') {
                    echo 'Testing application...'
                    sh '''
                        .venv/bin/python -c "from urllib.request import urlopen; r=urlopen('http://127.0.0.1:5000/'); print(r.read().decode()); assert r.status == 200"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the console output.'
        }
    }
}
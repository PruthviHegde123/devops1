pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Preparing Python application...'
                sh 'python3 --version'
                sh 'python3 -m pip --version'
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests...'
                sh 'python3 -m unittest discover -s .'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application...'
                sh '''
                    mkdir -p "${WORKSPACE}/python-app-deploy"
                    cp app.py requirements.txt "${WORKSPACE}/python-app-deploy/"
                '''
            }
        }

        stage('Run Application') {
            steps {
                echo 'Starting application...'
                sh '''
                    cd "${WORKSPACE}/python-app-deploy"
                    nohup python3 app.py > app.log 2>&1 &
                    echo $! > app.pid
                    sleep 3
                '''
            }
        }

        stage('Test Application') {
            steps {
                echo 'Testing application...'
                sh '''
                    python3 -c "from urllib.request import urlopen; r=urlopen('http://127.0.0.1:5000/'); print(r.read().decode()); assert r.status == 200"
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the console output.'
        }
    }
}
